{
  "name": "cartscout-coupons",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.14"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --env-file-if-exists=.env.clerk server/index.js",
    "start:replay": "OXYLABS_MODE=replay node --env-file-if-exists=.env.clerk server/index.js",
    "test": "node --test",
    "usage": "node --env-file-if-exists=.env scripts/usage.js",
    "seed:scan": "node scripts/seed-scan.js",
    "package:extension": "node --env-file-if-exists=.env --env-file-if-exists=.env.clerk scripts/package-extension.js"
  },
  "dependencies": {
    "@clerk/backend": "3.33.0",
    "@clerk/chrome-extension": "3.1.115"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "jsdom": "^29.1.1"
  }
}
