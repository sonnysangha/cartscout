OXYLABS_WEB_API_KEY=
PORT=8787
HOST=127.0.0.1
DATABASE_PATH=data/cartscout.sqlite
# Optional single market for this backend, e.g. GB, US, AE
OXYLABS_LOCATION=GB

# How much the server may spend. Every request sent to Oxylabs is counted, in UTC days and months, because Oxylabs
# bills by the UTC day. A scan or price lookup that the budget cannot cover is not started: saved results still open,
# and the member is told when live searching is back. Run "npm run usage" to see where both budgets stand.
OXYLABS_DAILY_REQUESTS=150
OXYLABS_MONTHLY_REQUESTS=2000
# live: scan shops and look up prices with Oxylabs, inside the budgets above.
# replay: never call Oxylabs. Scans and lookups are answered from the database, however old, and from the saved
#   answers in server/replay. No key is needed. "npm run start:replay" starts this way without reading .env.
# off: never call Oxylabs. Saved results still open and anything that needs live work is refused. No key is needed.
OXYLABS_MODE=live
# ai: Oxylabs' AI parsing reads the codes and prices out of every page. This is most of what a page read costs.
# local: only the page is asked for and CartScout reads it itself. Not yet checked against live pages.
OXYLABS_PAGE_PARSER=ai
# Set to 1 to save every raw Oxylabs answer as a file (up to 500 files of 1 MB), for use as test fixtures.
OXYLABS_RECORD=
# Optional folders. The defaults are server/replay and an oxylabs-recordings folder beside the database.
# OXYLABS_REPLAY_DIR=server/replay
# OXYLABS_RECORD_DIR=data/oxylabs-recordings

# Clerk development credentials shared with the account portal.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_ALLOWED_ORIGINS=http://localhost:8788,chrome-extension://oiiahmlikdllbbbahedcpbojgohonhao
CLERK_PRO_PLAN=pro
# Optional: the instance's JWKS public key (PEM, from Clerk's API keys page). With it, sessions are verified
# without calling Clerk at all.
CLERK_JWT_KEY=

# Convex cloud database & real-time backend (populated by `npx convex dev` into .env.local).
# When CONVEX_SITE_URL (or CONVEX_URL) and CARTSCOUT_CONVEX_SECRET are set, the API uses Convex instead of SQLite.
# Also set CLERK_JWT_ISSUER_DOMAIN and CARTSCOUT_CONVEX_SECRET on the Convex deployment via `npx convex env set`.
CONVEX_URL=
CONVEX_SITE_URL=
CARTSCOUT_CONVEX_SECRET=
