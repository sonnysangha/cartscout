{
  "manifest_version": 3,
  "name": "CartScout",
  "version": "1.1.0",
  "description": "Find and try coupon codes and compare retailers for the products in your basket.",
  "permissions": [
    "activeTab",
    "storage",
    "clipboardWrite",
    "scripting",
    "cookies"
  ],
  "host_permissions": [
    "http://localhost/*"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "CartScout",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "minimum_chrome_version": "120",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "key": "",
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  }
}
